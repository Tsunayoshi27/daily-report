# 环境变量模板
# 用法：复制本文件为 .env，按说明填写后保存（.env 已被 .gitignore 忽略，不会进入版本库）
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env

# ============================================================
# 必填：数据源与推送凭证（启动时缺失会直接报错）
# ============================================================
# GitHub 只读 Personal Access Token（classic 或 fine-grained 均可，只需 repo 读权限）
# 兼容两种键名：GITHUB_TOKEN 优先，GITHUB_PAT 作为兜底
# 注意：GITHUB_TOKEN 与 GITEE_TOKEN 至少填写一个
GITHUB_TOKEN=
# GITHUB_PAT=

# Gitee 私人令牌（Gitee → 设置 → 私人令牌，勾选 projects 只读权限即可）
# 公开仓库可留空（匿名可读）；私有仓库必填
GITEE_TOKEN=
# Gitee 采集目标：owner/repo，多个用英文逗号分隔（如 yourname/daily-report）
GITEE_REPOS=

# 飞书自建应用凭证（开放平台 → 开发者后台 → 应用详情 → 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# SMTP 邮件推送（授权码不是登录密码，需在邮箱设置里单独开启 SMTP 后获取）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_AUTH_CODE=
# 465 端口用 true（SSL）；587 端口（STARTTLS）用 false
SMTP_USE_SSL=true

# ============================================================
# 运行参数（均有默认值，可按需修改）
# ============================================================
# GitHub 采集目标：owner/repo，多个用英文逗号分隔；留空则跳过 GitHub 采集
GITHUB_REPOS=

# 日报作者与岗位（岗位仅支持 dev / pm / ops / sales）
# REPORT_AUTHOR 是日报抬头显示的名字（建议填 Gitee 昵称，如“乐天溪”）
REPORT_AUTHOR=
# 用于识别“我”的账号别名：Gitee/GitHub 登录名或昵称，英文逗号分隔
# 例：REPORT_IDENTITIES=tsunayoshi,乐天溪,Tsunayoshi27
# 留空则只认 REPORT_AUTHOR 一个名字
REPORT_IDENTITIES=
REPORT_ROLE=dev
# 邮件推送收件人，多个用英文逗号分隔；留空则跳过邮件推送（只导出文件）
EMAIL_RECIPIENTS=

# LLM 后端：mock（默认，零依赖）/ ollama（本地私有化模型，数据不出本机）
LLM_PROVIDER=mock
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=30

# 存储 / 输出 / 日志位置（留空则使用项目内默认路径 data/ 、output/ 、logs/）
DB_PATH=
OUTPUT_DIR=
LOG_DIR=
LOG_LEVEL=INFO

# ============================================================
# 可选：外部接口地址覆盖（一般无需修改，联调/测试时可指向代理或 Mock 服务）
# ============================================================
# GITHUB_API_BASE_URL=https://api.github.com
# GITEE_API_BASE_URL=https://gitee.com/api/v5
# FEISHU_BASE_URL=https://open.feishu.cn
# FEISHU_TASK_PATH=/open-apis/task/v1/tasks
